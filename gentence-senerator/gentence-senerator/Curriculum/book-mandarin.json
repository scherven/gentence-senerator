   "id": "zh.structures",
   "name": "Structures",
   "sub": "等…再… · 一…就… · 连…都…",
   "layout": "formulas",
   "entries": [
    {
     "id": "zh.structures.deng-zai",
     "head": "等…再…",
     "reading": "děng… zài…",
     "gloss": "not until …, then",
     "example": "等你下班，我们再吃饭。",
     "point": "deng-zai"
    },
    {
     "id": "zh.structures.yi-jiu",
     "head": "一…就…",
     "reading": "yī… jiù…",
     "gloss": "as soon as",
     "example": "他一回家就睡觉。",
     "point": "yi-jiu"
    },
    {
     "id": "zh.structures.lian-dou",
     "head": "连…都…",
     "reading": "lián… dōu…",
     "gloss": "even",
     "example": "他连饭都没吃。",
     "point": "lian-dou"
    },
    {
     "id": "zh.structures.suiran-danshi",
     "head": "虽然…但是…",
     "reading": "suīrán… dànshì…",
     "gloss": "although … still",
     "example": "虽然很贵，但是很好吃。",
     "point": "suiran-danshi"
    },
    {
     "id": "zh.structures.shi-de",
     "head": "是…的",
     "reading": "shì… de",
     "gloss": "stress when, where, how",
     "example": "我是坐飞机来的。",
     "point": "shi-de"
    },
    {
     "id": "zh.structures.budan-erqie",
     "head": "不但…而且…",
     "reading": "búdàn… érqiě…",
     "gloss": "not only … but also",
     "example": "她不但会唱歌，而且唱得很好。",
     "point": "budan-erqie"
    },
    {
     "id": "zh.structures.yue-yue",
     "head": "越…越…",
     "reading": "yuè… yuè…",
     "gloss": "the more … the more",
     "example": "雨越下越大。",
     "point": "yue-yue"
    },
    {
     "id": "zh.structures.yuelaiyue",
     "head": "越来越…",
     "reading": "yuèláiyuè…",
     "gloss": "more and more",
     "example": "天气越来越冷了。",
     "point": "yuelaiyue"
    },
    {
     "id": "zh.structures.zhiyao-jiu",
     "head": "只要…就…",
     "reading": "zhǐyào… jiù…",
     "gloss": "as long as",
     "example": "只要你来，我就高兴。",
     "point": "zhiyao-jiu"
    },
    {
     "id": "zh.structures.zhiyou-cai",
     "head": "只有…才…",
     "reading": "zhǐyǒu… cái…",
     "gloss": "only if",
     "example": "只有多练习，才能说好。",
     "point": "zhiyou-cai"
    },
    {
     "id": "zh.structures.chule-yiwai",
     "head": "除了…以外",
     "reading": "chúle… yǐwài",
     "gloss": "besides (还) · except (都)",
     "example": "除了汉语以外，他还会说日语。",
     "point": "chule-yiwai"
    },
    {
     "id": "zh.structures.xian-zai",
     "head": "先…再…",
     "reading": "xiān… zài…",
     "gloss": "first … then",
     "example": "先洗手，再吃饭。",
     "point": "xian-ranhou"
    },
    {
     "id": "zh.structures.yinwei-suoyi",
     "head": "因为…所以…",
     "reading": "yīnwèi… suǒyǐ…",
     "gloss": "because … so",
     "example": "因为下雨，所以比赛取消了。",
     "point": "yinwei-suoyi"
    },
    {
     "id": "zh.structures.ruguo-jiu",
     "head": "如果…就…",
     "reading": "rúguǒ… jiù…",
     "gloss": "if … then",
     "example": "如果明天下雨，我们就不去了。",
     "point": "ruguo-jiu"
    },
    {
     "id": "zh.structures.yibian",
     "head": "一边…一边…",
     "reading": "yìbiān… yìbiān…",
     "gloss": "while",
     "example": "他一边吃饭，一边看手机。",
     "point": "yibian-yibian"
    },
    {
     "id": "zh.structures.you-you",
     "head": "又…又…",
     "reading": "yòu… yòu…",
     "gloss": "both … and",
     "example": "这个苹果又大又甜。",
     "point": "you-you"
    },
    {
     "id": "zh.structures.kuaiyao-le",
     "head": "快要…了",
     "reading": "kuàiyào… le",
     "gloss": "about to",
     "example": "火车快要开了。",
     "point": "kuaiyao-le"
    },
    {
     "id": "zh.structures.cong-dao",
     "head": "从…到…",
     "reading": "cóng… dào…",
     "gloss": "from … to",
     "example": "从我家到学校要二十分钟。",
     "point": "cong-dao"
    },
    {
     "id": "zh.structures.tai-le",
     "head": "太…了",
     "reading": "tài… le",
     "gloss": "too, so",
     "example": "今天太热了！",
     "point": "tai-le"
    },
    {
     "id": "zh.structures.haishi-ba",
     "head": "还是…吧",
     "reading": "háishi… ba",
     "gloss": "had better",
     "example": "太晚了，我们还是打车吧。",
     "point": "haishi-ba"
    },
    {
     "id": "zh.structures.bushi-ma",
     "head": "不是…吗",
     "reading": "búshì… ma",
     "gloss": "isn't it …?",
     "example": "你不是说要来吗？",
     "point": "bushi-ma"
    },
