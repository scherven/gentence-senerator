  {
   "id": "zh.word-order",
   "name": "Word order",
   "sub": "明天在家看书 · 学了两年汉语 · 去过三次",
   "layout": "list",
   "entries": [
    {
     "id": "zh.word-order.time",
     "head": "时间 + V",
     "gloss": "when, before the verb",
     "example": "我明天去上海。",
     "point": "time-before-verb"
    },
    {
     "id": "zh.word-order.place",
     "head": "在 + 地方 + V",
     "gloss": "where, before the verb",
     "example": "我们在公园跑步。",
     "point": "zai-location"
    },
    {
     "id": "zh.word-order.time-place",
     "head": "时间 + 地方 + V",
     "gloss": "when, then where",
     "example": "我下午在图书馆看书。",
     "point": "adverbial-order"
    },
    {
     "id": "zh.word-order.manner",
     "head": "怎么 + V",
     "gloss": "how, before the verb",
     "example": "他慢慢地走过来了。",
     "point": "manner-before-verb"
    },
    {
     "id": "zh.word-order.adverb",
     "head": "也 · 都 · 常 + V",
     "gloss": "adverbs before the verb",
     "example": "我们也都是学生。",
     "point": "adverb-placement"
    },
    {
     "id": "zh.word-order.duration",
     "head": "V + 多久",
     "gloss": "how long, after the verb",
     "example": "我学了两年汉语。",
     "point": "duration-after-verb"
    },
    {
     "id": "zh.word-order.frequency",
     "head": "V + 几次",
     "gloss": "how many times, after the verb",
     "example": "我去过三次长城。",
     "point": "frequency-after-verb"
    },
    {
     "id": "zh.word-order.big-small",
     "head": "大 → 小",
     "gloss": "dates and addresses, largest first",
     "example": "2026年9月28号",
     "point": "big-to-small"
    },
    {
     "id": "zh.word-order.question-word",
     "head": "疑问词不动",
     "gloss": "question words stay put",
     "example": "你在哪儿工作？",
     "point": "question-word-in-situ"
    },
    {
     "id": "zh.word-order.topic",
     "head": "宾语在前",
     "gloss": "the object first, as topic",
     "example": "这本书我已经看完了。",
     "point": "topic-fronting"
    },
    {
     "id": "zh.word-order.serial",
     "head": "V₁ + V₂",
     "gloss": "go somewhere to do something",
     "example": "我去超市买水果。",
     "point": "serial-verb-purpose"
    },
    {
     "id": "zh.word-order.dao-qu",
     "head": "到 + 地方 + 去",
     "gloss": "going somewhere",
     "example": "他明天到上海去。",
     "point": "dao-place-qu"
    },
    {
     "id": "zh.word-order.existential",
     "head": "地方 + 有 + 东西",
     "gloss": "there is",
     "example": "桌子上有一本书。",
     "point": "existential-you"
    },
    {
     "id": "zh.word-order.time-clause",
     "head": "…以前 · …以后",
     "gloss": "before and after, at the end of the clause",
     "example": "下班以后我去健身房。",
     "point": "time-clause-order"
    },
    {
     "id": "zh.word-order.verb-copy",
     "head": "V + O + V得",
     "gloss": "say the verb twice",
     "example": "他开车开得很快。",
     "point": "verb-copying"
    },
    {
     "id": "zh.word-order.separable",
     "head": "见面 → 见过两次面",
     "gloss": "verbs that split",
     "example": "我跟他见过两次面。",
     "point": "separable-verbs"
